  lazy: true
solver:
  solver: glucose
  num_workers: 8
  params:
    cpu-lim: 5
    rnd-freq: 0.0
    K: 0.1
model:
  channels: 256
  num_layers: 10
  global_state_dim: 6
  aggr:
  - mean
  feature_encoder: mlp
  dropout: 0.0
  feature_set: rich
  separate_encoders: true
  learnable_sigma: true
  var_state_dim: 20
  event_adapter:
    enabled: true
    hidden_dim: 128
    fusion: weight_only_residual
    delta_scale: 1.0
    delta_clip: 0.25
    gate_indices:
    - 2
    - 3
    - 7
    - 8
    - 12
    - 13
    - 17
    - 18
    graph_gate_indices: null
    graph_gate_threshold: null
    base_rho_gate_threshold: null
    selector_feature_names: null
    selector_weights: null
    selector_bias: 0.0
    selector_threshold: 0.5
    selector_feature_mean: null
    selector_feature_std: null
    orbit_feature_dim: 10
    orbit_event_state_dim: 100
    require_valid_orbit: true
    min_orbit_event_variance: 1.0e-06
scale_sigma: 0.1
loader:
  batch_size: 8
  num_workers: 0
optim:
  lr: 3.0e-06
  weight_decay: 0.0
